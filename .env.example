# ─────────────────────────────────────────────
#  Zubair AI Agent v2 — Environment Variables
#  Copy this to .env and fill in your values
# ─────────────────────────────────────────────

PORT=100

# Email (Gmail App Password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_USER=syz
EMAIL_PASS=xyz
EMAIL_TO=xyz

# SERP API (for live error/tech search)
# Get free key at: https://serpapi.com (100 searches/month free)
SERP_API_KEY=xyz
# CORS
ALLOWED_ORIGINS=x

# Rate limiting
RATE_LIMIT_WINDOW_MS=100
RATE_LIMIT_MAX=4
