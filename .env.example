# ─────────────────────────────────────────────────────────────
#  Zubair AI Agent v3 — Environment Variables
#  Copy to .env locally. On Vercel add the same keys under
#  Settings → Environment Variables. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

PORT=5000

# ── Admin login (the /admin inbox) ───────────────────────────
ADMIN_USERNAME=zubairhussain
# Salted scrypt hash of your password — generate with:  npm run hash-password
# (the plain password is never stored anywhere)
ADMIN_PASSWORD_HASH=
# 32+ random characters used to sign JWTs — generate with:  npm run generate-secrets
JWT_SECRET=

# ── Web push notifications (from: npm run generate-secrets) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Storage (REQUIRED on Vercel) ─────────────────────────────
# Supabase free plan (recommended). Create a project, run
# supabase/schema.sql in the SQL Editor, then copy from
# Project Settings → API: the Project URL and the service_role
# (or "secret") key. The key is server-only — never ship it to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional alternative: Upstash Redis (used only if Supabase is not set)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CORS: exact origins allowed to call the public API ───────
# Comma-separated, no trailing slash. "*" is ignored on purpose.
ALLOWED_ORIGINS=https://zubairhussain.xyz,https://www.zubairhussain.xyz

# Text shown to visitors while you are away
REPLY_TIME_LABEL=within 1 hour

# ── Email (Gmail App Password) — optional ────────────────────
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# ── SERP API (live tech search) — optional ───────────────────
SERP_API_KEY=
